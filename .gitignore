# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ─── Virtual Environments ───
venv/
venv*/
env/
.venv/
audio_cutter/
.env

# ─── Uploads & Processed files ───
uploads/*
!uploads/.gitkeep
processed/*
!processed/.gitkeep
logs/*
!logs/.gitkeep

# ─── Downloaded Models (Whisper, Super-Res) ───
models/*
!models/.gitkeep

# ─── Performance benchmarking (never commit) ───
perf/__pycache__/

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo
*~
.agent/

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Internal / non-public dirs ───
github_profile/
github_profile_repo/

# ─── Misc ───
*.log


# ─── Runtime user data (never commit) ───
projects/*
!projects/.gitkeep
test_media_scratch/
data/
memory/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# ─── Test & tool artifacts ───
.pytest_cache/
.coverage
htmlcov/

# ─── Copilot personal skills (user-created) ───
user_skills/
