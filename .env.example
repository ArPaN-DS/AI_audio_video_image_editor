# ─────────────────────────────────────────────
#   Audio Cutter Pro — Environment Configuration
#   Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Flask secret key — CHANGE THIS to a long random string before deploying!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-very-long-random-secret-key-here

# Server port (default: 5000)
FLASK_PORT=5000

# Local reasoning models for the Autonomous Media Copilot (loopback only;
# non-local endpoints are rejected). Up to three tiers — the Copilot discovers
# which models each endpoint is serving and uses the largest one this machine
# can sustain, stepping down automatically if a tier is slow or fails.
LOCAL_REASONING_URL=http://127.0.0.1:8000/v1
# Baseline small model id (always the final fallback), e.g. your ~2B model.
LOCAL_REASONING_MODEL=local-media-copilot
# Optional mid-size model id (e.g. ~4B) and largest model id (e.g. ~12B).
LOCAL_REASONING_MODEL_BALANCED=
LOCAL_REASONING_MODEL_MAX=
# Optional separate endpoints when each tier runs in its own local server.
LOCAL_REASONING_URL_BALANCED=
LOCAL_REASONING_URL_MAX=
# auto (default) follows hardware; lite | balanced | max pins the reasoning ceiling.
LOCAL_REASONING_TIER=auto
# Small-model tuning (optional; see docs/SETUP.md). auto skips the model when the
# built-in planner is confident; always | local force one path.
LOCAL_REASONING_ROUTING=auto
# Context window for prompt budgeting (blank = read from the server, else 4096).
LOCAL_REASONING_CONTEXT_TOKENS=
# Prompt size target per request (blank = 1536 / 3072 / 6144 tokens by tier).
LOCAL_REASONING_PROMPT_TOKENS=
# json_schema | json_object | off (blank = auto, downgrades if unsupported).
LOCAL_REASONING_STRUCTURED_OUTPUT=

# Adaptive quality: auto (default) picks heavier, higher-fidelity models when
# free RAM / CPU / GPU memory allow and stays on lightweight models otherwise.
# Set lite | balanced | max to pin a ceiling.
MEDIA_QUALITY_TIER=auto

# ─── Optional: PostgreSQL Logging ────────────
# Leave blank to disable upload logging
DB_HOST=localhost
DB_PORT=5432
DB_NAME=audio_cutter_logs
DB_USER=postgres
DB_PASSWORD=
